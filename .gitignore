## ===========================================
## .gitignore para proyectos .NET / ASP.NET Core
## ===========================================

# ===========================================
# SECRETOS Y DATOS SENSIBLES
# ===========================================

# Archivos de configuración con secretos
appsettings.*.json
!appsettings.json
!appsettings.Development.json.example
secrets.json
*.secrets.json

# User secrets de .NET
secrets/

# Archivos de variables de entorno
.env
.env.*
!.env.example
*.local

# Certificados y claves
*.pfx
*.p12
*.pem
*.key
*.crt
*.cer
*.der
*.jks

# Azure y Cloud
.azure/
azure.json
servicePrincipal.json
publishsettings
*.publishsettings

# AWS
.aws/
aws-credentials
credentials

# Tokens y API Keys
**/tokens/
**/apikeys/
*.token

# ===========================================
# BUILD Y COMPILACIÓN
# ===========================================

[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Oo]ut/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
publish/
**/PublishOutput/

# MSBuild
*.binlog
msbuild.log
msbuild.err
msbuild.wrn

# ===========================================
# VISUAL STUDIO
# ===========================================

.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/

# Visual Studio cache/options directory
.vs/

# Visual Studio auto-generated files
Generated\ Files/

# Backup files
*.bak
*.backup

# ===========================================
# VISUAL STUDIO CODE
# ===========================================

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ===========================================
# JETBRAINS RIDER
# ===========================================

.idea/
*.sln.iml

# ===========================================
# NUGET
# ===========================================

*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
NuGet.config
nuget.config

# ===========================================
# TESTING
# ===========================================

[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
coverage/
*.coverage
*.coveragexml
CodeCoverage/
coverlet/
*.opencover.xml

# ===========================================
# ASP.NET
# ===========================================

ScaffoldingReadMe.txt
StyleCopReport.xml

# Entity Framework Migrations (local)
**/Migrations/*.Designer.cs

# wwwroot uploads (si aplica)
**/wwwroot/uploads/
**/wwwroot/temp/

# ===========================================
# BASES DE DATOS LOCALES
# ===========================================

*.mdf
*.ldf
*.ndf
*.sqlite
*.sqlite3
*.db
*.db3
*.sdf

# ===========================================
# DOCKER
# ===========================================

**/docker-compose.override.yml
.docker/

# ===========================================
# SISTEMA OPERATIVO
# ===========================================

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.fuse_hidden*
.nfs*

# ===========================================
# ARCHIVOS TEMPORALES
# ===========================================

~$*
*~
*.tmp
*.temp
*.swp
*.swo
*.bak
*.cache
.cache/

# ===========================================
# LOGS
# ===========================================

*.log
logs/
*.log.*
npm-debug.log*

# ===========================================
# OTROS
# ===========================================

# Archivos de licencia locales
*.lic
license.json

# Dumps y diagnósticos
*.dmp
*.dump
*.diagsession

# Archivos de respaldo de editores
*.orig

# Archivos generados por Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Archivos locales de documentación generada
docfx_project/
_site/
api/